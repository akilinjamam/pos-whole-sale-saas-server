{
  "name": "pos-whole-sale-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optical wholesale ERP + POS — REST API (Express + Mongoose, TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed/index.ts",
    "platform:create-admin": "tsx scripts/create-platform-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:shared": "node check-shared.mjs",
    "verify": "npm run check:shared && npm run typecheck && npm run lint && npm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "docker compose exec mongo mongosh --port 27019 --eval 'rs.initiate({_id:\"rs0\",members:[{_id:0,host:\"localhost:27019\"}]})'",
    "db:shell": "docker compose exec mongo mongosh --port 27019 pos_wholesale_saas"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nanoid": "^5.0.9",
    "nodemailer": "10.0.13",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.6",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
