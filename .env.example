# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# 5101: the retail POS uses 5000 and the original wholesale API uses 5100.
PORT=5101

# ─── Database ───────────────────────────────────────────────────────────────
# MUST be a replica set: Mongoose transactions require one, and every atomic stock
# movement, ledger posting and document-number allocation depends on transactions.
# `docker compose up -d` in the parent folder provides exactly this on 27019.
MONGODB_URI=mongodb://127.0.0.1:27019/?replicaSet=rs0
MONGODB_DB_NAME=pos_wholesale_saas

# ─── Locale ─────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ─── HTTP ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5175
# lax | strict | none. Set `none` when the client and API are on different sites
# (e.g. *.netlify.app → *.onrender.com) or refresh fails and users are logged out every 15m.
COOKIE_SAMESITE=lax
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=debug
# Put the full header block back into the HTTP request log (noisy; for debugging CORS/auth).
LOG_HTTP_HEADERS=false

# ─── SaaS: signup and email ─────────────────────────────────────────────────
# Where the web client lives; every link in an email starts with this.
APP_PUBLIC_URL=http://localhost:5175
SIGNUP_ENABLED=true
TRIAL_DAYS=14
# Requests per IP per 15 minutes on signup / forgot-password / reset / verify.
AUTH_RATE_LIMIT_MAX=10
# Leave SMTP_HOST empty in development: emails are written to the log instead.
# Required in production. Port 587 + SMTP_SECURE=false (STARTTLS), or 465 + true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Optical Wholesale <no-reply@example.com>"

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads

# ─── Seed (used from Day 2) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@wholesale.local
SEED_ADMIN_PASSWORD=

# One account per system role, so the permission split can be demonstrated (Day 4).
# Development only — `config.seed` refuses it when NODE_ENV=production.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=Demo1234!
